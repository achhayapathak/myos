# ==============================================================================
# MyOS — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# Obtain these values from your Supabase Dashboard:
#   Project Settings -> API (URL, anon key, service_role key)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Configuration (Safe for browser)
# ------------------------------------------------------------------------------
# The HTTPS URL of your Supabase project instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The Supabase public anonymous API key (anon key).
# This key is safe to be exposed to the browser as database operations are
# strictly guarded by PostgreSQL Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Server-Only Configuration (CRITICAL: DO NOT EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# The Supabase service-role secret key.
#
# !!! SECURITY WARNING !!!
# - NEVER expose this key to the browser or client-side bundles.
# - NEVER prefix this variable with NEXT_PUBLIC_.
# - This key completely bypasses PostgreSQL Row Level Security (RLS).
# - Only use this key in secure server-only functions, background sync tasks,
#   or administrative migrations.
# - Normal application flows, user queries, and Server Actions MUST use
#   the anon key with authenticated user sessions to enforce RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
